<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:background="#F3F7F3" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/contenido_formulario" android:focusableInTouchMode="true" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nuevo_registro" android:textSize="12sp" android:textColor="#176149" android:id="@+id/txt_modo" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/registrar" android:textSize="28sp" android:textColor="#143B30" android:id="@+id/txt_titulo" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/campos_obligatorios" android:textSize="15sp" android:textColor="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sector" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_sector" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_sector" android:hint="@string/ejemplo_sector" android:inputType="text|textCapCharacters" android:textColor="#143B30" android:textColorHint="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tipo" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_tipo" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_tipo" android:hint="@string/ejemplo_tipo" android:inputType="text|textCapSentences" android:textColor="#143B30" android:textColorHint="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/captura" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_captura" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_captura" android:hint="@string/ejemplo_captura" android:inputType="number" android:textColor="#143B30" android:textColorHint="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/observaciones" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_observaciones" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_observaciones" android:hint="@string/ejemplo_observaciones" android:inputType="text|textCapSentences|textMultiLine" android:textColor="#143B30" android:textColorHint="#435B52" android:minLines="2" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_guardar" android:text="@string/guardar" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#176149" android:minHeight="48dp" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_eliminar" android:text="@string/eliminar" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#A02F37" android:minHeight="48dp" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_volver" android:text="@string/volver" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#435B52" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>