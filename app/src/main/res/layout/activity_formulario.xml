<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:background="#F3F7F3" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/contenido_formulario" android:focusableInTouchMode="true" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NUEVO REGISTRO" android:textSize="12sp" android:textColor="#176149" android:id="@+id/txt_modo" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar trampa" android:textSize="28sp" android:textColor="#143B30" android:id="@+id/txt_titulo" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Completa los campos marcados con *." android:textSize="15sp" android:textColor="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Código de sector *" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_sector" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_sector" android:hint="Ej. ARI-01" android:inputType="text|textCapCharacters" android:textColor="#143B30" android:textColorHint="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tipo de trampa *" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_tipo" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_tipo" android:hint="Ej. McPhail" android:inputType="text|textCapSentences" android:textColor="#143B30" android:textColorHint="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nivel de captura *" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_captura" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_captura" android:hint="Ej. 12" android:inputType="number" android:textColor="#143B30" android:textColorHint="#435B52" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Observaciones" android:textSize="15sp" android:textColor="#143B30" android:labelFor="@id/campo_observaciones" android:textStyle="bold" android:paddingTop="12dp" />
        <EditText android:backgroundTint="#176149" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/campo_observaciones" android:hint="Ej. Revisada durante la mañana" android:inputType="text|textCapSentences|textMultiLine" android:textColor="#143B30" android:textColorHint="#435B52" android:minLines="2" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_guardar" android:text="Guardar trampa" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#176149" android:minHeight="48dp" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_eliminar" android:text="Eliminar trampa" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#A02F37" android:minHeight="48dp" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_volver" android:text="Volver al listado" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#435B52" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>