<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:background="#F3F7F3" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MONITOREO EN TERRENO" android:textSize="12sp" android:textColor="#176149" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FlyTrap IoT" android:textSize="32sp" android:textColor="#143B30" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="#435B52" android:id="@+id/txt_resumen" android:paddingBottom="10dp" />
    <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boton_registrar" android:text="Registrar trampa" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#176149" android:minHeight="48dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:background="#F3F7F3" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/lista_trampas" android:dividerHeight="1dp" />
        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/txt_vacio" android:textSize="16sp" android:textColor="#435B52" android:gravity="center" />
    </FrameLayout>
</LinearLayout>